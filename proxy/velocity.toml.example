# Copy this file to velocity.toml before starting Velocity.
# The backend Paper server stays bound to 127.0.0.1:25566.
bind = "0.0.0.0:25565"
motd = "26.2 Eagler Server"
show-max-players = 50
online-mode = false
force-key-authentication = false
player-info-forwarding-mode = "none"
announce-forge = false
kick-existing-players = false
ping-passthrough = "DISABLED"
enable-player-address-logging = true

[servers]
lobby = "127.0.0.1:25566"
try = ["lobby"]

[forced-hosts]
